{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.1.0",
  "default_locale": "ko",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_page": "options/options.html",
  "commands": {
    "capture-region": {
      "suggested_key": {
        "windows": "Alt+1"
      },
      "description": "__MSG_region__"
    },
    "capture-element": {
      "suggested_key": {
        "windows": "Alt+2"
      },
      "description": "__MSG_element__"
    },
    "capture-full": {
      "suggested_key": {
        "windows": "Alt+3"
      },
      "description": "__MSG_full__"
    },
    "capture-visible": {
      "suggested_key": {
        "windows": "Alt+4"
      },
      "description": "__MSG_visible__"
    }
  }
}
